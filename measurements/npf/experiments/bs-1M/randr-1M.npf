%info

spdk-fio benchmark

%config

n_runs=10
var_names={BS:Block Size, BANDWIDTH:Throughput (MB/s), SIZE:S, IODEPTH:D}
graph_force_diagonal_labels=true
graph_serie=ENGINE

%variables
RW={randread}
IODEPTH={1,16,32}
SIZE={1M,10M,100M,1G}
ENGINE={spdk_bdev,libaio}

%script@server

if [[ "${ENGINE}" == "spdk_bdev" ]];
then
    if [ -b "/dev/nvme0n1" ]; then
        PCI_ALLOWED="0000:02:00.0" /etinfo/users/2021/njeanmenne/spdk/scripts/setup.sh
        sleep 5
    fi
    LD_PRELOAD=/etinfo/users/2021/njeanmenne/spdk/build/fio/spdk_bdev fio --name=npf_spdk-fio_read \
              --ioengine=${ENGINE} \
              --spdk_json_conf=/etinfo/users/2021/njeanmenne/master-thesis/src/simple-config.json \
              --filename=Nvme0n1 \
              --direct=1 \
              --thread=1 \
              --rw=${RW} \
              --bs=1M \
              --iodepth=${IODEPTH} \
              --size=${SIZE} \
              --output-format=json > fio.json
else

    if [ ! -b "/dev/nvme0n1" ]; then
        /etinfo/users/2021/njeanmenne/spdk/scripts/setup.sh reset
        sleep 5
    fi

    fio --name=npf_spdk-fio_read \
              --ioengine=${ENGINE} \
              --filename=/dev/nvme0n1 \
              --direct=1 \
              --rw=${RW} \
              --bs=1M \
              --iodepth=${IODEPTH} \
              --size=${SIZE} \
              --output-format=json > fio.json
fi

if [[ "${RW}" == *"read"* ]];
then
    bw_bps=$(jq '.jobs[0].read.bw_bytes' fio.json)
else
    bw_bps=$(jq '.jobs[0].write.bw_bytes' fio.json)
fi

// Convert to MB/s and report back to NPF
bw_mbs=$(echo "scale=2; $bw_bps / 1048576" | bc)

echo "RESULT-BANDWIDTH $bw_mbs"
